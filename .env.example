# =============================================================================
# Laravet — plantilla de variables de entorno
#
# Copia este archivo a `.env` (cp .env.example .env) y genera la clave con
# `php artisan key:generate`. En desarrollo con SQLite no hace falta cambiar nada
# más. Las líneas comentadas con `#` son alternativas: descomenta solo lo que uses.
# El `.env` nunca se sube a git.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME=Laravet
# local | staging | production. Los datos demo solo se siembran en local y staging.
APP_ENV=local
APP_KEY=
# false en staging y producción (con true se muestran errores detallados).
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
# La zona horaria de la clínica se configura en el panel: Configuración → Datos de la clínica.

# --- Registro de errores -----------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos -----------------------------------------------------------
# Por defecto SQLite (database/database.sqlite, se crea al migrar). Producción usa MySQL.
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/completa/al/database.sqlite

# MySQL (comenta DB_CONNECTION=sqlite de arriba y descomenta estas líneas):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravet
# DB_USERNAME=root
# DB_PASSWORD=

# --- Cola, caché y sesiones --------------------------------------------------
# Igual que en producción: todo en la base de datos (tablas jobs, cache y sessions).
# Con la cola en `database` hace falta un worker para que salgan los correos y avisos:
# `composer run dev` ya lo levanta; por separado: `php artisan queue:listen --tries=1`.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# --- Correo ------------------------------------------------------------------
# `log` escribe los correos en storage/logs/laravel.log: ideal para desarrollo.
MAIL_MAILER=log
# Remitente base. La migración de configuración lo copia a «Datos de la clínica» y se
# usa de respaldo si esa dirección deja de ser válida. En producción debe ser una
# dirección de un dominio verificado en el proveedor de correo.
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Dominios extra verificados en el proveedor, separados por coma (además del de MAIL_FROM_ADDRESS).
# MAIL_ALLOWED_FROM_DOMAINS=

# --- Diagnóstico asistido por IA (opcional) ----------------------------------
# Sin la clave, el botón «Asistir con IA» muestra un error y el resto funciona igual.
# Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Primera siembra ---------------------------------------------------------
# Usuario administrador que crea `php artisan laravet:seed` (la contraseña se genera y
# se muestra una sola vez en la consola).
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@mbopivet.com.py

# Datos demo (solo local y staging; nunca en producción).
# Contraseña de los usuarios demo. Sin ella: «password» en local y una aleatoria en staging.
DEMO_PASSWORD=
# Mascotas que agrega `composer run seed:volume`, para probar paginación y exportación.
DEMO_VOLUME=200

# --- Producción (referencia) -------------------------------------------------
# Lo que cambia en el servidor (valores de ejemplo; usa los tuyos):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://laravet.tu-dominio.com.py
# DB_CONNECTION=mysql   (con DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD)
# MAIL_MAILER=resend
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS="no-reply@tu-dominio.com.py"
# MAIL_ALLOWED_FROM_DOMAINS=
# LOG_LEVEL=error
